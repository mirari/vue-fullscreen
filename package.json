{
  "name": "vue-fullscreen-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @vue-fullscreen/vue3 dev",
    "dev:vue2": "pnpm --filter @vue-fullscreen/vue2 dev",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "node scripts/build.mjs",
    "build:examples": "pnpm -r build:example",
    "check:packages": "node scripts/check-packages.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build && pnpm run check:ie11 && pnpm run check:packages && pnpm run build:examples && pnpm run docs:build",
    "release:prepare": "node scripts/release.mjs --prepare",
    "release": "node scripts/release.mjs",
    "docs:dev": "pnpm run docs:prepare && vitepress dev docs --host 0.0.0.0",
    "docs:build": "pnpm run docs:prepare && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "test:docs": "playwright test --config playwright.docs.config.ts",
    "docs:prepare": "node scripts/prepare-docs.mjs",
    "test:consumers": "pnpm run build && node scripts/prepare-consumers.mjs && playwright test --config playwright.consumers.config.ts",
    "check:ie11": "node scripts/check-ie11.mjs"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@vue/compiler-sfc": "3.5.43",
    "acorn": "8.19.0",
    "codemirror": "6.0.2",
    "commit-and-tag-version": "13.3.0",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "core-js": "3.50.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "screenfull": "6.0.2",
    "semver": "7.7.4",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitepress": "1.6.4",
    "vitest": "5.0.3",
    "vue": "3.5.43"
  },
  "packageManager": "pnpm@12.14.0"
}
