{
  "name": "vue-fullscreen-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/vue2",
    "packages/vue3"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @vue-fullscreen/vue3",
    "dev:vue2": "npm run dev -w @vue-fullscreen/vue2",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "node scripts/build.mjs",
    "build:examples": "npm run build:example --workspaces",
    "check:packages": "node scripts/check-packages.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:packages && npm run build:examples && npm run docs:build",
    "release:prepare": "node scripts/release.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev docs --host 0.0.0.0",
    "docs:build": "npm run docs:prepare && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "test:docs": "playwright test --config playwright.docs.config.ts",
    "docs:prepare": "node scripts/prepare-docs.mjs",
    "test:consumers": "npm run build && node scripts/prepare-consumers.mjs && playwright test --config playwright.consumers.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "screenfull": "6.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitepress": "1.6.4",
    "vitest": "5.0.3",
    "vue": "3.5.43"
  }
}
